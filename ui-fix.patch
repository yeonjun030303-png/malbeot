+<script>
+/* ===================== 뷰포트/키보드/핀치줌 안정화 (2026-09-17) =====================
+   문제 1) iOS WKWebView에서 키보드가 뜰 때 100dvh가 곧바로 줄어들지 않아 .app-container
+           전체가 실제 화면보다 커져서 채팅 입력창(전송 버튼)이 화면 밖으로 밀리던 현상
+   문제 2) 프로필 등 화면 최초 진입 시 콜드스타트 직후 100dvh 값이 아직 안정화되기 전에
+           렌더링되어 화면이 위로 쏠리고 렉이 걸리던 현상
+   → window.visualViewport의 실제 픽셀 높이를 JS로 직접 읽어 .app-container 높이에
+     인라인으로 강제 적용. dvh 단위 하나에만 의존하지 않게 해서 타이밍 문제를 없앰.
+   문제 3) 채팅창에서 실수로 두 손가락 터치 등으로 화면이 확대된 채 고정되고
+           페이지를 이동해도 축소가 안 되던 현상 → viewport meta에서 이미 확대 자체를
+           막아뒀고(user-scalable=no), 예전에 이미 확대된 상태로 남아있을 가능성에
+           대비해 앱 진입/복귀 시 배율을 1로 되돌리는 안전장치를 추가함
+*/
+(function(){
+  function setAppViewportHeight(){
+    var container = document.getElementById('appContainer');
+    if(!container) return;
+    var vp = window.visualViewport;
+    var h = vp ? vp.height : window.innerHeight;
+    var ratio = window.innerWidth >= 500 ? 0.92 : 1;
+    container.style.height = Math.round(h * ratio) + 'px';
+  }
+
+  window.addEventListener('resize', setAppViewportHeight);
+  window.addEventListener('orientationchange', setAppViewportHeight);
+  if (window.visualViewport){
+    window.visualViewport.addEventListener('resize', setAppViewportHeight);
+    window.visualViewport.addEventListener('scroll', setAppViewportHeight);
+  }
+  document.addEventListener('DOMContentLoaded', setAppViewportHeight);
+  window.addEventListener('load', setAppViewportHeight);
+  document.addEventListener('visibilitychange', function(){
+    if (!document.hidden) setAppViewportHeight();
+  });
+  // 콜드스타트 직후 값이 늦게 잡히는 경우 대비해 잠깐 뒤에 한 번 더 재계산
+  setTimeout(setAppViewportHeight, 50);
+  setTimeout(setAppViewportHeight, 300);
+  setAppViewportHeight();
+
+  // 이미 확대된 상태로 남아있을 경우 배율을 원위치로 되돌리는 안전장치
+  function resetPinchZoom(){
+    var meta = document.querySelector('meta[name="viewport"]');
+    if (!meta) return;
+    var content = meta.getAttribute('content');
+    meta.setAttribute('content', content + ', maximum-scale=1.0');
+    meta.setAttribute('content', content);
+  }
+  document.addEventListener('visibilitychange', function(){
+    if (!document.hidden) resetPinchZoom();
+  });
+  window.addEventListener('pageshow', resetPinchZoom);
+})*
+</script>
 </body>
